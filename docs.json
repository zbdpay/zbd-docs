  "customCss": ":root:root {\n  --weight-heading: 700;\n}\n:root:root {\n  --sidebar-font-size: 14px;\n  --sidebar-row-padding-y: calc(6em / 14);\n  --sidebar-row-gap: calc(3em / 14);\n  --sidebar-group-margin-top: calc(20em / 14);\n}\n\n/* FRAGILE: inline-TOC heading rows under the active page — pad to match main nav rows. May break on Holocron updates. */\n.slot-sidebar-left nav a[href*=\"#\"] {\n  padding-block: var(--sidebar-row-padding-y) !important;\n}\n/* FRAGILE: hide the powered-by credit block (keeps Prev/Next page nav). May break on Holocron updates. */\nfooter .opacity-40:has(a[href*=\"utm_source=powered-by\"]) {\n  display: none;\n}\n\n/* FRAGILE: pin API request/response example modules right below the copy-markdown button in the right rail (they scroll normally with the page). May break on Holocron updates. */\n@media (min-width: 1024px) {\n  body:has(.slot-aside [role=\"tablist\"][aria-label=\"Request example\"]) .slot-aside:not(:has([role=\"tablist\"][aria-label=\"Request example\"])) > .flex.w-full.flex-col {\n    position: static !important;\n  }\n  body:has(.slot-aside [role=\"tablist\"][aria-label=\"Request example\"]) .slot-aside:has([role=\"tablist\"][aria-label=\"Request example\"]) > .flex.w-full.flex-col {\n    position: absolute !important;\n    top: calc(var(--sticky-top) + 46px) !important;\n    max-height: none !important;\n    width: var(--grid-sidebar-width, 460px);\n  }\n}\n\n/* FRAGILE: Mintlify-style card layout — icon as left column, title on top, description below. May break on Holocron updates. */\n.slot-main .group\\/card > div.pointer-events-none {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  column-gap: 14px;\n  row-gap: 4px;\n  align-items: start;\n}\n.slot-main .group\\/card > div.pointer-events-none > .flex.items-center.gap-2 {\n  display: contents;\n}\n.slot-main .group\\/card > div.pointer-events-none > .flex.items-center.gap-2 > svg,\n.slot-main .group\\/card > div.pointer-events-none > .flex.items-center.gap-2 > img {\n  grid-column: 1;\n  grid-row: 1 / span 2;\n  align-self: center;\n  width: 24px !important;\n  height: 24px !important;\n  color: var(--primary);\n}\n.slot-main .group\\/card .text-sm.font-semibold {\n  grid-column: 2;\n  grid-row: 1;\n  font-size: 15px;\n}\n.slot-main .group\\/card > div.pointer-events-none > .flex.flex-col.gap-3 {\n  grid-column: 2;\n  grid-row: 2;\n}\n.slot-main .group\\/card > div.pointer-events-none > .text-xs.text-primary {\n  grid-column: 2;\n  grid-row: 3;\n}\n\n/* FRAGILE: heading hierarchy — h2/h3 step down from the config h1 size. May break on Holocron updates. */\n.slot-main .editorial-h2 { font-size: 22px; }\n.slot-main .editorial-h3 { font-size: 19px; }"
